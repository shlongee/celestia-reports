---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Shlongeeland"
  description="Programming journey, graphics experiments, and dev reports by Shlongee."
  immersive
>
  <section class="wormhole-home" aria-label="Shlongeeland">
    <div class="title-particles" aria-hidden="true">
      <canvas data-title-particles data-title="SHLONGEELAND"></canvas>
    </div>

    <h1 class="title-particles__fallback" data-title-fallback data-title="SHLONGEELAND">
      SHLONGEELAND
    </h1>

    <nav class="wormhole-home__nav" aria-label="Primary navigation">
      <a class="wormhole-nav__btn" data-warp-link href="/blog/">Blog</a>
      <a class="wormhole-nav__btn" data-warp-link href="/tags/">Tags</a>
      <a class="wormhole-nav__btn" data-warp-link href="/about/">About</a>
    </nav>
    
    <footer class="home-micro-footer">
      <a href="https://github.com/shlongee" rel="me noopener noreferrer" target="_blank">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href="/rss.xml">RSS</a>
    </footer>
  </section>
</BaseLayout>

<script src="../scripts/title-particles.ts"></script>