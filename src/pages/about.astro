---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Visualizer from '../components/Float16Visualizer.astro'

const pageTitle = "About"
---

<html lang="en">
	<head>
		<meta charset="utf-8">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Shlongeeland - {pageTitle}</title>
		<style>
			h1 {
				color: #ff90f2;
				font-size: 4rem;
			}
			.cool {
				color: greenyellow;
				font-weight: bold;
			}
		</style>
	</head>
	<body>
		<Header />

		<h1>This is gonna be epic!</h1>
        <h2>My name is Shlongee :3</h2>

        <p class="cool">I'm working through Astro's introductory tutorial. This is second page already!</p>

        <p>This site will update and become even more epic as I progress the tutorial!</p>
		<Visualizer />
		<Footer />
	</body>
</html>