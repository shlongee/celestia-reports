---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogSearch from "../../components/BlogSearch";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const initialPosts = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  pubDate: post.data.pubDate.toISOString(),
  tags: post.data.tags,
}));

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags)),
).sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title="Blog"
  description="Code spells, shader notes, and dev stories."
>
  <h1>Spellbook</h1>
  <p class="page-lede">Simple notes on code, shaders, and bugs turned into magic.</p>
  <BlogSearch client:load initialPosts={initialPosts} allTags={allTags} />
</BaseLayout>