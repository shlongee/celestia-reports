---
import { Font } from "astro:assets";
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  immersive?: boolean;
  ogType?: "website" | "article";
  pubDate?: Date;
}

const {
  title,
  description,
  immersive = false,
  ogType = "website",
  pubDate,
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={{ immersive }}>
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--kejter" preload />
    <Seo title={title} description={description} ogType={ogType} pubDate={pubDate} />
    <slot name="head" />
  </head>
  <body class:list={{ immersive }}>
    <canvas class="wormhole-global-bg" data-space-wormhole aria-hidden="true"></canvas>
    <div class="viewport-vignette" aria-hidden="true"></div>

    {immersive ? (
      <main>
        <slot />
      </main>
    ) : (
      <div class="codex-shell">
        <div class="codex-sheet">
          <Header />
          <main class="site-main">
            <slot />
          </main>
          <Footer />
        </div>
      </div>
    )}

    <script>
      import { mountSpaceWormhole } from "../scripts/space-wormhole";
      import { mountCursorGlow } from "../scripts/cursor-glow";
      mountSpaceWormhole();
      mountCursorGlow();
    </script>
  </body>
</html>