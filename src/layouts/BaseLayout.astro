---
import { Font } from "astro:assets";
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
  title: string;
  description: string;
  immersive?: boolean;
  ogType?: "website" | "article";
  pubDate?: Date;
}

const {
  title,
  description,
  immersive = false,
  ogType = "website",
  pubDate,
} = Astro.props;
---

<!doctype html>
<html lang="en" class:list={{ immersive }}>
  <head>
    <meta charset="UTF-8" />
    <Font cssVariable="--zyzol" preload />
    <Seo title={title} description={description} ogType={ogType} pubDate={pubDate} />
    <slot name="head" />
  </head>
  <body class:list={{ immersive }}>
    {!immersive && <Header />}
    <main class:list={{ "site-main": !immersive }}>
      <slot />
    </main>
    {!immersive && <Footer />}
  </body>
</html>