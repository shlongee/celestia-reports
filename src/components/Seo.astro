---
export interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: "website" | "article";
  pubDate?: Date;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogType = "website",
  pubDate,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://shlongee.github.io";
const canonical = new URL(path, `${siteUrl}/`).toString();
const fullTitle = title === "Shlongeeland" ? "Shlongeeland" : `${title} — Shlongeeland`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Shlongeeland" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="Shlongeeland RSS" href={`${siteUrl}/rss.xml`} />