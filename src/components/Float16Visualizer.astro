---
// src/components/Float16Visualizer.astro
---
<div class="fp-viz">
  <div class="controls">
    <label>
      Intensity: <strong class="val-int">8.0x</strong>
      <input type="range" class="slider-int" min="1" max="25" step="0.5" value="8" />
    </label>
    <label>
      Max Glow Tail: <strong class="val-max">0.05</strong>
      <input type="range" class="slider-max" min="0.01" max="0.25" step="0.01" value="0.05" />
    </label>
  </div>

  <canvas class="viz-canvas" width="700" height="190"></canvas>
  <p class="readout">Move sliders to amplify faint glow steps into visible banding.</p>
</div>

<script>
  function quantizeFloat(x: number, mantissaBits: number): number {
    if (x <= 0) return 0;
    const exp = Math.floor(Math.log2(x));
    if (exp < -14) {
      const step = Math.pow(2, -14 - mantissaBits);
      return Math.round(x / step) * step;
    }
    if (exp > 15) return 65504;
    const step = Math.pow(2, exp - mantissaBits);
    return Math.round(x / step) * step;
  }

  function quantize8Bit(x: number): number {
    return Math.min(1, Math.round(Math.max(0, x) * 255) / 255);
  }

  document.querySelectorAll('.fp-viz').forEach((root) => {
    const canvas = root.querySelector<HTMLCanvasElement>('.viz-canvas');
    const ctx = canvas?.getContext('2d');
    const sInt = root.querySelector<HTMLInputElement>('.slider-int');
    const sMax = root.querySelector<HTMLInputElement>('.slider-max');
    const lInt = root.querySelector<HTMLElement>('.val-int');
    const lMax = root.querySelector<HTMLElement>('.val-max');

    if (!canvas || !ctx || !sInt || !sMax || !lInt || !lMax) return;

    const formats: { label: string; fn: (v: number) => number }[] = [
      { label: 'R8G8B8A8 (8-bit: fixed 1/255 steps)', fn: (v) => quantize8Bit(v) },
      { label: 'R11G11B10_FLOAT (32-bit HDR: 6/6/5-bit mantissa)', fn: (v) => quantizeFloat(v, 5) },
      { label: 'R16G16B16A16 (64-bit HDR: 10-bit mantissa)', fn: (v) => quantizeFloat(v, 10) },
    ];

    const draw = () => {
      const intensity = parseFloat(sInt.value);
      const maxGlow = parseFloat(sMax.value);
      lInt.textContent = `${intensity.toFixed(1)}x`;
      lMax.textContent = maxGlow.toFixed(2);

      const w = canvas.width;
      const barH = 44;
      const gap = 22;

      ctx.fillStyle = '#111';
      ctx.fillRect(0, 0, w, canvas.height);

      formats.forEach((fmt, idx) => {
        const y = 20 + idx * (barH + gap);
        for (let px = 0; px < w; px++) {
          const t = px / (w - 1);
          const raw = t * maxGlow;
          const q = fmt.fn(raw);
          const out = Math.min(1, q * intensity);
          const c = Math.round(out * 255);
          ctx.fillStyle = `rgb(${c}, ${Math.round(c * 0.55)}, ${Math.round(c * 0.15)})`;
          ctx.fillRect(px, y, 1, barH);
        }
        ctx.fillStyle = '#eee';
        ctx.font = '12px monospace';
        ctx.fillText(fmt.label, 8, y - 5);
      });
    };

    sInt.addEventListener('input', draw);
    sMax.addEventListener('input', draw);
    draw();
  });
</script>

<style>
  .fp-viz {
    background: #18181b;
    padding: 1rem;
    border-radius: 10px;
    border: 1px solid #333;
    margin: 1.5rem 0;
  }
  .controls {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
    color: #e4e4e7;
    font-size: 0.9rem;
  }
  .viz-canvas {
    width: 100%;
    height: auto;
    border-radius: 6px;
    display: block;
  }
  .readout {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: #a1a1aa;
  }
</style>